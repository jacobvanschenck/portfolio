---
import BaseLayout from "../layouts/BaseLayout.astro";

const contributions = [
  "Led the Capacitor client from early Turborepo scaffolding into a production-grade mobile/web app, authoring 485 commits in the monorepo.",
  "Built real-time bunch chat with Phoenix channels, optimistic updates, message history, edits, deletes, reactions, threads, and Zod validation.",
  "Shaped the typed GraphQL and Apollo data layer with reusable fragments, generated TypeScript types, mutations, subscriptions, and targeted cache updates.",
  "Integrated native mobile flows through Capacitor, including Android delivery, push notifications, deep links, media, sharing, haptics, permissions, and cloud settings.",
  "Designed and implemented the REP token ecosystem, wallet persistence, EIP-712 signing, meta-transactions, smart accounts, and gasless onchain interaction patterns.",
];

const technologies = [
  "React / Next.js",
  "TypeScript",
  "Capacitor",
  "Apollo / GraphQL",
  "Phoenix channels",
  "Zustand",
  "Solidity / REP",
  "viem / wagmi / ethers",
];

const productScreens = [
  {
    title: "Chat",
    webpSrc: "/bunches/bunches-chat-688.webp",
    srcSet:
      "/bunches/bunches-chat-480.webp 480w, /bunches/bunches-chat-688.webp 688w",
    width: 688,
    height: 1288,
    alt: "Bunches mobile chat screen",
  },
  {
    title: "Profile",
    webpSrc: "/bunches/bunches-profile-mobile-748.webp",
    srcSet:
      "/bunches/bunches-profile-mobile-480.webp 480w, /bunches/bunches-profile-mobile-748.webp 748w",
    width: 748,
    height: 1426,
    alt: "Bunches mobile profile screen",
  },
  {
    title: "Ranking",
    webpSrc: "/bunches/bunches-ranking-730.webp",
    srcSet:
      "/bunches/bunches-ranking-480.webp 480w, /bunches/bunches-ranking-730.webp 730w",
    width: 730,
    height: 1334,
    alt: "Bunches mobile ranking screen",
  },
  {
    title: "Scoreboard",
    webpSrc: "/bunches/bunches-scoreboard-640.webp",
    srcSet:
      "/bunches/bunches-scoreboard-480.webp 480w, /bunches/bunches-scoreboard-640.webp 640w",
    width: 640,
    height: 1166,
    alt: "Bunches mobile scoreboard screen",
  },
  {
    title: "Takes",
    webpSrc: "/bunches/bunches-takes-740.webp",
    srcSet:
      "/bunches/bunches-takes-480.webp 480w, /bunches/bunches-takes-740.webp 740w",
    width: 740,
    height: 1402,
    alt: "Bunches mobile takes screen",
  },
];
---

<BaseLayout
  title="Bunches | Jacob Van Schenck"
  description="Product engineering case study for Bunches, a mobile-first social app with real-time chat, native mobile flows, GraphQL infrastructure, and REP token interactions."
>
  <div class="w-full">
    <main class="flex flex-col gap-20 px-8 pt-32 mx-auto w-full max-w-250">
      <section class="flex flex-col gap-8">
        <a
          href="/#work"
          class="flex gap-2 items-center self-start font-bold transition-all duration-150 group"
        >
          <span class="transition-transform duration-75 ease-in-out group-hover:-translate-x-1">
            {"<"}
          </span>
          Back
        </a>
        <div class="flex flex-col gap-5">
          <h1 class="text-4xl font-bold text-foreground leading-tight sm:text-6xl">
            Bunches. Chat Sports.
          </h1>
          <p class="max-w-3xl text-lg">
            A mobile-first social app for sports communities with real-time
            chat, group discovery, direct messages, rewards, picks, native
            Android flows, and REP-powered onchain interactions.
          </p>
        </div>
      </section>

      <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class="text-3xl font-bold text-foreground">Overview</h2>
        <div class="flex flex-col gap-4">
          <p>
            Bunches needed a community product where sports fans could join
            groups, chat in real time, share content, receive notifications,
            make picks, earn rewards, and use REP without being exposed to raw
            wallet or transaction complexity.
          </p>
          <p>
            I was the primary engineer behind the Capacitor client app and REP
            ecosystem, connecting product surfaces to real-time messaging, typed
            GraphQL data, native mobile APIs, non-custodial wallet persistence,
            analytics, release automation, and gasless onchain flows.
          </p>
        </div>
      </section>

      <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class="text-3xl font-bold text-foreground">Impact</h2>
        <ul class="grid gap-3">
          {contributions.map((item) => (
            <li class="p-4 rounded-xl border bg-card text-card-foreground">
              {item}
            </li>
          ))}
        </ul>
      </section>

      <section class="flex flex-col gap-8">
        <div class="flex flex-col gap-3">
          <h2 class="text-3xl font-bold text-foreground">Product Screens</h2>
          <p>
            Real Bunches screens from the mobile app and Android delivery flow:
            chat, profile, rankings, scoreboard, takes, and device install
            context.
          </p>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          <figure class="overflow-hidden rounded-2xl border shadow-xl md:col-span-2 transition-all hover:translate-y-0.5 duration-75 ease-in-out">
            <img
              src="/bunches/bunches-on-android-1200.webp"
              srcset="/bunches/bunches-on-android-1200.webp 1200w, /bunches/bunches-on-android-1800.webp 1800w"
              sizes="(min-width: 768px) 936px, calc(100vw - 64px)"
              alt="Bunches running on Android"
              class="w-full"
              width="2472"
              height="1480"
              loading="lazy"
            />
            <figcaption class="py-3 px-4 text-sm font-bold bg-card text-card-foreground">
              Android App Delivery
            </figcaption>
          </figure>
          <div class="grid grid-cols-2 gap-5 md:col-span-2 lg:grid-cols-5">
            {productScreens.map((screen) => (
              <figure class="flex overflow-hidden flex-col justify-between bg-white rounded-2xl border shadow-xl transition-all hover:translate-y-0.5 duration-75 ease-in-out">
                <img
                  src={screen.webpSrc}
                  srcset={screen.srcSet}
                  sizes="(min-width: 1024px) 168px, (min-width: 768px) 458px, calc((100vw - 84px) / 2)"
                  alt={screen.alt}
                  class="pb-4 w-full bg-white"
                  width={screen.width}
                  height={screen.height}
                  loading="lazy"
                />
                <figcaption class="flex justify-center items-center py-3 px-3 text-sm font-bold text-center bg-card text-card-foreground">
                  {screen.title}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class="text-3xl font-bold text-foreground">Tech & Constraints</h2>
        <div class="flex flex-col gap-5">
          <ul class="flex flex-wrap gap-2">
            {technologies.map((tech) => (
              <li class="py-1 px-3 text-xs rounded-3xl sm:text-sm bg-secondary text-secondary-foreground hover:bg-secondary/90 hover:translate-y-0.5 transition-all duration-75 ease-in-out">
                {tech}
              </li>
            ))}
          </ul>
          <p>
            The key engineering challenge was coordinating native mobile
            behavior, web rendering, realtime messaging, GraphQL server state,
            local interaction state, wallet recovery, signed transactions,
            analytics, observability, and release workflows across a
            multi-package app.
          </p>
        </div>
      </section>

      <a
        href="/#bunches"
        class="flex gap-2 items-center self-start pb-20 font-bold transition-all duration-75 ease-in-out group"
      >
        <span class="transition-transform duration-150 group-hover:-translate-x-1">
          {"<"}
        </span>
        Back
      </a>
    </main>
  </div>
</BaseLayout>
