import WorkSection from "../components/WorkSection.astro";
import ProjectSection from "../components/ProjectSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="jacobvs.xyz"
  description="Jacob Van Schenck is a full-stack product engineer building scalable platforms across backend architecture, public APIs, permissions, admin workflows, and polished user experiences."
>
  <div class="w-full">
    <main class="flex flex-col mx-auto w-full max-w-lg gap-12 md:pt-28 px-8 py-16">
      <HeroSection />
      <WorkSection />
      <ProjectSection />
    </main>
  </div>
</BaseLayout>
