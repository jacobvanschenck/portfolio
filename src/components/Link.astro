---
export interface Props {
  label: string;
  link: string;
  class?: string;
}

const { label, link, class: className, ...props } = Astro.props;
---

<a
  class:list={[className, "sm:text-lg hover:text-primary group font-bold"]}
  href={link}
  target="_blank"
  {...props}
>
  {label}
  <div class="mt-1 h-1 bg-primary transition-transform duration-100 scale-x-0 group-hover:scale-x-100"></div>
</a>
