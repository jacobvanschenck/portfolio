---
import ContactIcons from "./ContactIcons.astro";
---

<section class="flex flex-col gap-8">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-[1.5px] stroke-foreground fill-none w-10 h-10"
  >
    <path d="m7 11 2-2-2-2" />
    <path d="M11 13h4" />
    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
  </svg>
  <h1 class="font-medium text-foreground leading-snug font-terminal">
    Jacob Van Schenck is a product builder.
  </h1>
  <p>
    Currently at <span class="text-foreground">Overflow</span> building the best
    generosity platform for churches and nonprofits. Previous at{" "}
    <span class="text-foreground">Bunches</span> where I built a realtime chat
    app (android) and web3 fan token ecosystem.
    <br />
    <br /> When I am not building killer software, you can find me building in
    my woodshop, drinking coffee with my wife or reading LOTR to my 3 beautiful
    kids.
  </p>
  <ContactIcons />
</section>
