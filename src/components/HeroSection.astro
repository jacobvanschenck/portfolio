---
import ContactIcons from "./ContactIcons.astro";
---

<section class="flex flex-col gap-8">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="stroke-[1.5px] stroke-foreground fill-none w-10 h-10"
  >
    <path d="m7 11 2-2-2-2" />
    <path d="M11 13h4" />
    <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
  </svg>
  <h1 class="font-medium text-foreground leading-snug font-terminal">
    Jacob Van Schenck is a product builder.
  </h1>
  <p>
    I am a full-stack product engineer who turns complex domains into reliable
    software. I work across backend architecture, public APIs, permissions,
    admin workflows, donor and consumer product surfaces, and polished user
    experiences, with a bias toward systems that are clear for teams to extend
    and useful for the people relying on them.
  </p>
  <ContactIcons />
</section>
